{
  "version": 2,
  "public": true,
  "headers": [
    {
      "source": "/(.*)\\.(js|css|jpg|jpeg|png|gif|ico|svg|webp|json)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "$1"
    }
  ]
}